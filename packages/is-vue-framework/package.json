{
  "name": "@southneuhof/is-vue-framework",
  "private": false,
  "version": "2.0.0",
  "type": "module",
  "description": "Vue application framework components and patterns for South Neuhof information systems.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/southneuhof/is-vue-framework.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./services": "./src/services/index.ts",
    "./adapters/defaults": "./src/adapters/defaults.ts",
    "./adapters/state": "./src/adapters/state.ts",
    "./adapters/*": "./src/adapters/*",
    "./components/*": "./src/components/*",
    "./renderers/*": "./src/renderers/*",
    "./utilities/*": "./src/utilities/*",
    "./styles/*": "./src/styles/*",
    "./router": "./src/router/index.ts",
    "./router/*": "./src/router/*",
    "./runtime": "./src/runtime.ts",
    "./runtimeDefaults": "./src/runtimeDefaults.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "dependencies": {
    "@southneuhof/utilities": "workspace:^",
    "@tanstack/vue-query": "5.101.4",
    "@tinymce/tinymce-vue": "^6.0.1",
    "@vuepic/vue-datepicker": "^11.0.3",
    "@vueuse/core": "^12.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "radix-vue": "^1.9.2",
    "tailwind-merge": "^1.13.1",
    "tinymce": "^7.2.1",
    "uuid": "^11.0.2",
    "vaul-vue": "^0.3.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.1",
    "vue-tippy": "^6.7.1",
    "vue-to-print": "^1.2.1",
    "vue3-google-map": "^0.15.0",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^20.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "scripts": {
    "build": "pnpm run type-check",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --environment jsdom"
  }
}
