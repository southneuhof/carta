{
  "name": "@southneuhof/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/drizzle-kit/bin.cjs migrate && node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs run",
    "test:focused": "sh -c 'shift; exec node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs run \"$@\"' --",
    "lint:focused": "eslint",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset-db.ts && pnpm run db:migrate",
    "db:refresh": "pnpm run db:reset && pnpm run db:seed",
    "db:smoke": "tsx --env-file-if-exists=.env scripts/smoke-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./rpc": "./src/rpc.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@hono/node-server": "^2.0.6",
    "@hono/zod-validator": "^0.8.0",
    "@southneuhof/sprindle": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.27",
    "pg": "^8.22.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^2.1.9"
  }
}
